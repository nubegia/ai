# ─── CONFIG ───────────────────────────────────────────────────────────
MODEL                 = os.getenv("OPENAI_MODEL", "gpt-5-mini")   # ✅ Use GPT-5-mini
API_KEY               = os.getenv("OPENAI_API_KEY", "")  # ← Set via env var or replace here
MAX_OUTPUT_TOKENS     = 4096
HTTP_TIMEOUT_SECS     = 600
TEMPERATURE           = 0.1   # Low temperature for consistent, factual outputs
MAX_RETRIES           = 2     # Retry attempts for validation failures

if not API_KEY or not API_KEY.startswith("sk-"):
    raise RuntimeError("❌ Missing or invalid OPENAI_API_KEY. Please set it as environment variable or in the script.")

_ctx   = ssl.create_default_context(cafile=certifi.where())
_http  = httpx.Client(verify=_ctx, timeout=HTTP_TIMEOUT_SECS, follow_redirects=True)
client = OpenAI(api_key=API_KEY, http_client=_http)

print("✅ OpenAI client initialized successfully (GPT-5-mini with enhanced settings).")

