# VALIDATION & QUERY FUNCTIONS (IMPROVED)
# ======================================================================

def validate_json_answer(json_str, question):
    """
    Validate that the JSON answer is well-formed and contains quality content.
    Returns: (is_valid: bool, result: dict or error_message: str)
    """
    required_fields = ["answer", "law_website", "link", "summary"]

    try:
        data = json.loads(json_str)

        # Check all required fields are present
        missing_fields = [f for f in required_fields if f not in data]
        if missing_fields:
            return False, f"Missing required fields: {', '.join(missing_fields)}"

        # Check for empty or placeholder answers
        answer_lower = str(data["answer"]).lower().strip()
        if not data["answer"] or answer_lower in ["n/a", "not available", "unknown", ""]:
            return False, "Answer is empty or placeholder (N/A)"

        # Check law_website is not empty
        if not data["law_website"] or len(data["law_website"].strip()) < 5:
            return False, "Law/Website citation is too short or empty"

        # Check summary has sufficient detail
        if not data["summary"] or len(data["summary"].strip()) < 50:
            return False, "Summary is too short (minimum 50 characters)"

        # Check link format (should be URL-like or explicit note)
        link_str = str(data["link"]).strip()
        if not link_str or link_str.lower() in ["n/a", "none", ""]:
            # Allow if explanation provided in summary
            if "not available" not in data["summary"].lower():
                return False, "Link missing without explanation"

        return True, data

    except json.JSONDecodeError as e:
        return False, f"Invalid JSON: {str(e)}"
    except Exception as e:
        return False, f"Validation error: {str(e)}"


def get_legal_answer(economy, question, topic="Assets and women's rights"):
    """
    Send a structured legal query to GPT-5-mini using enhanced prompting and validation.
    Returns parsed JSON dict or None on failure.
    """
    system_prompt = SYSTEM_PROMPT_TMPL.format(topic=topic, economy=economy)

    # Enhanced user prompt with chain-of-thought
    user_prompt = f"""
Answer the following WBL question for {economy}:

Question: {question}

Before providing your JSON response, please think through:
1. What is the relevant legal framework?
2. Which specific laws, codes, or regulations apply?
3. Were there any amendments between Sep 2023 - Sep 2024?
4. What is the most evidence-based answer?

Then provide your answer in the required JSON format.
"""

    for attempt in range(MAX_RETRIES + 1):
        try:
            if attempt > 0:
                print(f"   🔄 Retry attempt {attempt}/{MAX_RETRIES}...")

            response = client.chat.completions.create(
                model=MODEL,
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": user_prompt}
                ],
                temperature=TEMPERATURE,
                max_completion_tokens=MAX_OUTPUT_TOKENS,  # Use max_completion_tokens for GPT-5 models
                top_p=0.95,
                frequency_penalty=0.0,
                presence_penalty=0.0,
                response_format={"type": "json_object"}  # Force JSON output
            )

            json_output = response.choices[0].message.content

            if not json_output:
                print(f"   ⚠️ Empty response on attempt {attempt + 1}")
                continue

            # Validate the output
            is_valid, result = validate_json_answer(json_output, question)

            if is_valid:
                print(f"   ✅ Valid response received")
                return result
            else:
                print(f"   ⚠️ Validation failed: {result}")
                if attempt == MAX_RETRIES:
                    print(f"   ⚠️ Max retries reached. Returning raw JSON anyway.")
                    # Try to return something even if validation failed
                    try:
                        return json.loads(json_output)
                    except:
                        return None

        except Exception as e:
            print(f"   ❌ Error on attempt {attempt + 1}: {str(e)}")
            if attempt == MAX_RETRIES:
                print(f"   ❌ Max retries exhausted for {economy}")
                return None

    return None


